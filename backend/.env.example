# ── Server ──
HOST=0.0.0.0
PORT=8000
DEBUG=true
SECRET_KEY=change-me-to-a-random-string

# ── Database (MySQL) ──
DATABASE_URL=mysql+aiomysql://lifeos:lifeos@localhost:3306/lifeos
DATABASE_URL_SYNC=mysql+pymysql://lifeos:lifeos@localhost:3306/lifeos

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── LLM ──
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=4096

# ── Ollama (local LLM + embedding) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3

# ── Object Storage (MinIO / S3) ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gaussian-files
MINIO_SECURE=false

# ── Gaussian Training ──
GAUSSIAN_WORK_DIR=/data/gaussian-train
GAUSSIAN_GPU_MEMORY=20000
GAUSSIAN_MAX_POINTS=1000000
